{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akitenkrad/rs-runvault/schema/v1/index.columns.meta.json",
  "title": "meta-schema for index.columns.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tables"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "primary_key",
          "columns"
        ],
        "properties": {
          "primary_key": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "nullable"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "type": {
                  "enum": [
                    "string",
                    "bigint",
                    "double",
                    "boolean",
                    "timestamp"
                  ]
                },
                "nullable": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                }
              }
            },
            "uniqueItems": true
          },
          "null_equality": {
            "type": "boolean",
            "description": "主キーに nullable な列を含む場合に true. 重複判定で NULL 同士を同値とみなす (IS NOT DISTINCT FROM)"
          }
        }
      }
    }
  }
}
