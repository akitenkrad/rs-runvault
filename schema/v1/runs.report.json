{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akitenkrad/rs-runvault/schema/v1/runs.report.json",
  "title": "runs.json (Obsidian dashboard payload)",
  "description": "runvault report --obsidian が vault に書き出す索引の要約. CLI と Emera コンポーネントの契約",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vocab_version",
    "generated_at",
    "freshness_hours",
    "experiments",
    "runs",
    "warnings",
    "metric_vocabulary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.5"
    },
    "vocab_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "freshness_hours": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "これを超えて古ければ画面に «古い» と出す (既定 24)"
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment",
          "repo_id",
          "n_runs",
          "n_finished",
          "last_run_at",
          "primary_metrics",
          "jira",
          "metric_docs"
        ],
        "properties": {
          "experiment": {
            "anyOf": [
              {
                "$ref": "common.json#/$defs/slug"
              },
              {
                "type": "null"
              }
            ],
            "description": "legacy run が results 直下に置かれていると，どの実験のものか記録に無い．その場合の 1 まとまりが null (実データでは 237 件中 233 件がこれ)"
          },
          "repo_id": {
            "$ref": "common.json#/$defs/slug"
          },
          "n_runs": {
            "type": "integer",
            "minimum": 0
          },
          "n_finished": {
            "type": "integer",
            "minimum": 0
          },
          "last_run_at": {
            "anyOf": [
              {
                "$ref": "common.json#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "git_remote": {
            "type": [
              "string",
              "null"
            ],
            "description": "そのリポジトリの origin. run.json にしか無いので, legacy run しか持たない実験では null"
          },
          "primary_metrics": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "common.json#/$defs/slug"
            },
            "description": "一覧に出す指標名. 実験ごとに決まる (§5.4)"
          },
          "jira": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^MYTASK-[0-9]+$"
            },
            "description": "その実験の run が参照する課題キー (重複なし). runs[] は max_runs で打ち切られるため, 研究テーマ別の束ねはこちらから組む — 打ち切りの外にある実験がテーマから丸ごと消えるのを防ぐ"
          },
          "metric_docs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "names",
              "patterns"
            ],
            "description": "この実験の指標が何を測っているか (設計書 §3.11). 説明は run ではなく実験の性質なので experiments[] が持つ — runs[].metrics は主要な 12 件しか載せていないため, そちらに付けると届かない",
            "properties": {
              "names": {
                "type": "object",
                "description": "指標名そのものの説明. リポジトリの runvault.toml が宣言し, run が写したもの",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "meaning"
                  ],
                  "properties": {
                    "meaning": {
                      "type": "string"
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "ratio / count / sec / usd など. 値の隣に出す"
                    },
                    "direction": {
                      "anyOf": [
                        {
                          "enum": [
                            "up",
                            "down",
                            "none"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "どちらが良いか. null は «誰も決めていない» であって «どちらでもない» ではない — 画面は推測で «良い / 悪い» を言わない"
                    }
                  }
                }
              },
              "patterns": {
                "type": "array",
                "description": "名前の形の説明. 生成された木はこちらで説明される (javitz1991 は 4 つの形で 11,309 件). 名前ごとの説明が先に見られ, 当たらなければ上から順に形を試す",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pattern"
                  ],
                  "properties": {
                    "pattern": {
                      "type": "string",
                      "description": "区画を `.` で区切った雛形. `{名前}` の区画は軸で, 任意の 1 区画に当たる. 区画の数まで一致しないと当たらない"
                    },
                    "meaning": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "何を測っているか. 形の宣言は書かないことがある"
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "ratio / count / sec / usd など. 値の隣に出す"
                    },
                    "direction": {
                      "anyOf": [
                        {
                          "enum": [
                            "up",
                            "down",
                            "none"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "どちらが良いか. null は «誰も決めていない» であって «どちらでもない» ではない — 画面は推測で «良い / 悪い» を言わない"
                    },
                    "axes": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "軸名からその位置の意味へ"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_key",
          "repo_id",
          "experiment",
          "subcommand",
          "state",
          "created_at",
          "git_dirty",
          "metrics"
        ],
        "properties": {
          "run_uid": {
            "anyOf": [
              {
                "$ref": "common.json#/$defs/run_uid"
              },
              {
                "type": "null"
              }
            ],
            "description": "legacy run では null"
          },
          "run_slug": {
            "anyOf": [
              {
                "$ref": "common.json#/$defs/run_slug"
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "人が付けた run の名前. これが無い run は run_slug の末尾で見分ける — 既存の run はどれも持たない"
          },
          "experiment": {
            "anyOf": [
              {
                "$ref": "common.json#/$defs/slug"
              },
              {
                "type": "null"
              }
            ],
            "description": "legacy では記録に無いことがある"
          },
          "subcommand": {
            "anyOf": [
              {
                "$ref": "common.json#/$defs/slug"
              },
              {
                "type": "null"
              }
            ],
            "description": "legacy では不明"
          },
          "state": {
            "enum": [
              "finished",
              "failed",
              "unfinished",
              null
            ],
            "description": "legacy run には status.json が無く，どう終わったかが記録に無い．unfinished は «status.json が無い正規の run» を意味するので，そこに混ぜず null にする"
          },
          "created_at": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "duration_sec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "git_dirty": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "その実験の主要な指標だけ (出現回数の多い順に vocabulary.toml の [report] summary_metrics 件まで. primary_metrics は必ず含む). **run が記録した全部ではない** — 1 run が 1,270 個持つ実験があり, 全部を載せると日次で作り直す派生物が 20 MB になる. 全部は metrics.csv にあり, 画面は比べる数本だけを読む"
          },
          "n_metrics": {
            "type": "integer",
            "minimum": 0,
            "description": "その run が記録した run スコープ (step 無し) の指標の総数. metrics が 12 個しか無いことを画面が «12 / 1,270» と言えるようにするために要る"
          },
          "replication": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "title",
              "targets"
            ],
            "properties": {
              "title": {
                "$ref": "common.json#/$defs/nonempty"
              },
              "work_id": {
                "$ref": "common.json#/$defs/work_id"
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "diff": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": "number"
                },
                "description": "再現値 - 論文報告値"
              }
            }
          },
          "obsidian_note": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "jira": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^MYTASK-[0-9]+$"
            }
          },
          "run_key": {
            "$ref": "common.json#/$defs/nonempty",
            "description": "索引の主キー. legacy は legacy:<repo_id>:<相対パス>"
          },
          "repo_id": {
            "$ref": "common.json#/$defs/slug",
            "description": "どのリポジトリの run か. 集約先での置き場 (<集約先>/<repo_id>/…) を引くのに要る"
          },
          "sweep_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "その run が属する sweep. 親も点も同じ値を持つ. 40 点の sweep を 40 個の無関係な行にしないために要る (run.json の lineage.sweep_id)"
          },
          "parent_run_uid": {
            "anyOf": [
              {
                "$ref": "common.json#/$defs/run_uid"
              },
              {
                "type": "null"
              }
            ],
            "description": "sweep の点なら親 run. 親自身と単発の run では null"
          },
          "sweep_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "sweep のグリッド上の位置 (0 始まり). «7/40» の 7 は index+1"
          },
          "sweep_total": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "そのグリッドの点の総数"
          },
          "config_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "description": "条件のハッシュ. legacy run には無い"
          },
          "env_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "description": "環境のハッシュ. 同じ config_hash で割れていれば «条件は同じなのに環境が違う» (warnings の env_split が指しているもの)"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "message"
        ],
        "properties": {
          "kind": {
            "enum": [
              "env_split",
              "dirty_runs",
              "stale_lock",
              "legacy_runs"
            ]
          },
          "message": {
            "$ref": "common.json#/$defs/nonempty"
          },
          "config_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "n_run": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "metric_vocabulary": {
      "type": "object",
      "description": "予約指標の意味. 語彙 (vocabulary.toml [metric_names]) が決めるものでリポジトリのものではないので, experiments[] に写さず 1 か所に置く. 画面は «名前の宣言 → 予約語 → 形» の順に見る",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meaning"
        ],
        "properties": {
          "meaning": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
